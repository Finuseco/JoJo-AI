# Inside the TLS server for ai.cashpay-all.com.
# One Next.js application on 8095 serves pages AND all /api/ routes.
location / {
    proxy_pass http://127.0.0.1:8095;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_buffering off;
    proxy_read_timeout 300;
    proxy_send_timeout 300;
    client_max_body_size 45m;
    add_header Referrer-Policy no-referrer always;
}
# Configure TLS through the existing certificate manager.
# The optional /android/ viewer location is only needed for a configured emulator worker.
